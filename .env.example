# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# The default configuration costs nothing and needs no account: discovery runs
# against a local Ollama model, and replay never calls a model at all.

# --- Planner (discovery only; replay ignores all of this) -------------------
# ollama | google
UNDERSTUDY_PLANNER=ollama

# Local, free, offline. No key involved. A plain instruct model, not a
# hybrid-thinking one - see the comment atop src/discovery/providers/ollama.ts
# for the measured reason: qwen3:4b spent minutes on invisible "thinking"
# tokens per decision on CPU-only hardware, with no way found to suppress it.
# qwen2.5:7b-instruct, not the smaller 3b, because 7b is what every discovery
# run actually committed to evidence/ used - see the same comment for why the
# faster 3b model is not what this repository's own evidence stands behind.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only needed if UNDERSTUDY_PLANNER=google. Google AI Studio's free tier, no
# card required. src/discovery/providers/google.ts exists to prove the
# provider seam is real - swapping the model driving discovery is a
# constructor call - not because any evidence in this repository was recorded
# with it; every committed discovery run used Ollama.
GOOGLE_AI_API_KEY=

# --- Cost governor ---------------------------------------------------------
# Hard ceiling on estimated spend for a single discovery run, in USD. The loop
# tracks token cost and aborts before crossing it. 0 means "refuse to run
# anything that would cost money", which is the default on purpose.
UNDERSTUDY_MAX_USD=0

# --- Cassette --------------------------------------------------------------
# off    — talk to the planner normally
# record — talk to the planner and write the exchange to evidence/
# replay — serve responses from a recorded cassette, zero calls
UNDERSTUDY_CASSETTE=replay

# --- Target application ----------------------------------------------------
TARGET_APP_PORT=4501
TARGET_APP_TENANT=meridian
